# Local sample and public GitHub imports work without any credentials.
# Cloud persistence / email sign-in: enable anonymous sign-ins in Supabase too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional server-only public-repository token; private repositories are refused.
GITHUB_TOKEN=
# Prune key only; the Gemini provider key stays in Prune Vault.
LLM_BASE_URL=https://api.withprune.com/v1
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# Local models may use http://127.0.0.1 endpoints; explicit opt-in required.
LLM_ALLOW_LOCAL=false
LLM_DAILY_CALL_LIMIT=20
# Bounded 1–45 seconds. No automatic provider retries.
LLM_TIMEOUT_MS=45000
# Set only after verifying this key's saved Shield cap and enforcement.
# Hosted AI fails closed while false, even if credentials are configured.
PRUNE_SHIELD_VERIFIED=false
# Must be an exact public origin when deployed. Local origin is derived safely.
APP_ORIGIN=http://127.0.0.1:3000
