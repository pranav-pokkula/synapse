# Local sample and public GitHub imports work without any credentials.
# Cloud persistence / email sign-in: enable anonymous sign-ins in Supabase too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional server-only public-repository token; private repositories are refused.
GITHUB_TOKEN=
# OpenAI-compatible chat-completions endpoint. Never use NEXT_PUBLIC_ for secrets.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Local models may use http://127.0.0.1 endpoints; explicit opt-in required.
LLM_ALLOW_LOCAL=false
LLM_DAILY_CALL_LIMIT=20
# Must be an exact public origin when deployed. Local origin is derived safely.
APP_ORIGIN=http://127.0.0.1:3000
